# Get a free key at https://console.groq.com
GROQ_API_KEY=

# Model names -- see README "Groq model notes" before changing these.
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_SMART=openai/gpt-oss-120b

# Free-tier rate limiting (requests/minute). Groq's free tier is roughly
# 30 rpm; we default to 20 to leave headroom for concurrent demo traffic.
GROQ_MAX_RPM=20
GROQ_CACHE_TTL=3600
